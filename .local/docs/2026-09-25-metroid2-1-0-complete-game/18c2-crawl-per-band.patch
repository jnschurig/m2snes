+/// 1.0 Step 18c2: the door edges out of rooms the crawl reached from the new
+/// game into rooms it never did, and what each door tests.
+fn truthFrontier(gpa: std.mem.Allocator, rom: []const u8, out: *std.Io.Writer) !void {
+    var w = try roster.world(gpa, rom);
+    defer w.deinit(gpa);
+    var inf = try warp.Inference.init(gpa, rom, w);
+    defer inf.deinit(gpa);
+    const walked = try warp.loadWalked(gpa, rom);
+    var truth: std.AutoHashMapUnmanaged(u16, void) = .empty;
+    var tried: std.AutoHashMapUnmanaged(u32, void) = .empty;
+    for (walked) |wd| {
+        if (wd.to_truth) try truth.put(gpa, wd.to_room, {});
+        if (wd.from_truth) try truth.put(gpa, wd.from_room, {});
+        if (wd.from_truth) try tried.put(gpa, @as(u32, wd.from.bank) << 16 | @as(u32, wd.from.cell) << 8 | @intFromEnum(wd.dir), {});
+    }
+    var n: usize = 0;
+    for (w.edges) |e| {
+        const from = w.roomOf(e.from);
+        if (!truth.contains(from)) continue;
+        const to = warp.roomAt(w, e.dest.to);
+        if (to == roster.World.none or truth.contains(to)) continue;
+        var tb: [8]u8 = undefined;
+        const ths = inf.thresholdsOf(e.index, &tb);
+        const walked_here = tried.contains(@as(u32, e.from.bank) << 16 | @as(u32, e.from.cell) << 8 | @intFromEnum(e.dir));
+        try out.print("${X}:${X:0>2} {s: <5} door ${X:0>3} -> ${X}:${X:0>2} room {d}  thresholds {X}  {s}\n", .{ e.from.bank, e.from.cell, @tagName(e.dir), e.index, e.dest.to.bank, e.dest.to.cell, to, ths, if (walked_here) "walked elsewhere" else "never walked" });
+        n += 1;
+    }
+    try out.print("{d} frontier edges; {d} rooms from truth\n", .{ n, truth.count() });
+    var seen: [256]bool = @splat(false);
+    for (inf.decoded.ops.items) |op| switch (op) {
+        .if_met_less => |x| seen[x.met_count] = true,
+        else => {},
+    };
+    try out.print("IF_MET_LESS operands:", .{});
+    for (seen, 0..) |b, i| if (b) try out.print(" ${X:0>2}", .{i});
+    try out.print("\n", .{});
+}
