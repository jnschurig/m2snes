+/// A script that draws `t` at Metroid count `count`: one that loads it whole,
+/// else one that loads its graphics and metatile table, which is all a picture
+/// needs. **A script that tests no count first**: it draws `t` at any count. A
+/// gated one draws `t` at `count`, and at another count what that count shows,
+/// which for the lava's rooms is the right picture too.
+pub fn drawingLoader(decoded: door.Decoded, ptrs: []const u8, rows: []const u8, s0: State, t: Tileset, count: u8) ?u16 {
+    for ([_]Writes{ w_tileset, w_bg | w_tiletable }) |need| {
+        for ([_]bool{ false, true }) |gated| {
+            for (1..door.pointer_count) |i| {
+                const ops = screens.scriptOps(decoded, ptrs, i) orelse continue;
+                var counted = false;
+                var queen = false;
+                var warps = false;
+                for (ops) |op| switch (op) {
+                    .if_met_less => counted = true,
+                    .warp => warps = true,
+                    .enter_queen, .exit_queen, .escape_queen => queen = true,
+                    else => {},
+                };
+                if (queen or !warps or counted != gated) continue;
+                const s, const wr = runScript(decoded, ptrs, rows, s0, @intCast(i), count);
+                if (wr & need != need) continue;
+                if (need == w_tileset and !Tileset.of(s).eql(t)) continue;
+                if (!s.bg.eql(t.bg) or s.tiletable != t.tiletable) continue;
+                return @intCast(i);
+            }
+        }
     }
     return null;
 }
